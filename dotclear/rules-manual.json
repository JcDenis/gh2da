{
    "about": "Manual compatibility rules, merged by scripts/dotclear-rules.php into rules.json (see RULES.md). A rule with the id of a generated one replaces its fields; \"disabled\": true removes it.",
    "rules": [
        {
            "id": "class:dcCore",
            "replace": "App::… (App::blog(), App::auth(), App::con(), App::frontend()->context()…)",
            "note": "Class removed with all its legacy aliases (dcCore::app()->blog, ->auth, ->con, ->ctx, ->tpl…), even with DC_MODERN off"
        },
        {
            "id": "class:dcUtils",
            "replace": "App::lexical(), App::plugins()->cssLoad(), My::cssLoad(), My::jsLoad()…",
            "note": "Class removed"
        },
        {
            "id": "js:toggleWithLegend",
            "type": "js",
            "symbol": "$.fn.toggleWithLegend",
            "pattern": "(?<!dotclear)\\.toggleWithLegend\\s*\\(",
            "level": "notice",
            "replace": "dotclear.toggleWithLegend(element, target, options)",
            "note": "jQuery plugin deprecated (admin/js/legacy.js), no longer used by the core"
        },
        {
            "id": "js:toggleWithDetails",
            "type": "js",
            "symbol": "$.fn.toggleWithDetails",
            "pattern": "(?<!dotclear)\\.toggleWithDetails\\s*\\(",
            "level": "notice",
            "replace": "dotclear.toggleWithDetails(element, options)",
            "note": "jQuery plugin deprecated (admin/js/legacy.js)"
        },
        {
            "id": "method:Dotclear\\Helper\\Html\\XmlTag::nodes",
            "type": "method",
            "symbol": "Dotclear\\Helper\\Html\\XmlTag::nodes",
            "since": "2.40",
            "level": "alert",
            "unique": true,
            "replace": "getNodes()",
            "note": "Magic method renamed (conflict with __set())"
        },
        {
            "id": "method:Dotclear\\Helper\\Html\\XmlTag::node",
            "type": "method",
            "symbol": "Dotclear\\Helper\\Html\\XmlTag::node",
            "since": "2.40",
            "level": "alert",
            "replace": "getNode(int $index)",
            "note": "Magic method renamed (conflict with __set())"
        },
        {
            "id": "method:Dotclear\\Helper\\Html\\XmlTag::name",
            "type": "method",
            "symbol": "Dotclear\\Helper\\Html\\XmlTag::name",
            "since": "2.40",
            "level": "alert",
            "replace": "getName()",
            "note": "Magic method renamed (conflict with __set())"
        },
        {
            "id": "property:Dotclear\\Core\\Frontend\\Utility::$search_count",
            "type": "property",
            "symbol": "Dotclear\\Core\\Frontend\\Utility::$search_count",
            "since": "2.40",
            "level": "notice",
            "replace": "",
            "note": "App::frontend()->search_count is now an int"
        },
        {
            "id": "method:Dotclear\\Plugin\\widgets\\WidgetsElement::setting",
            "note": "Options (radio, combo) are now the 5th argument, the old trailing 6th argument (opts) is removed: check calls with options"
        },
        {
            "id": "method:Dotclear\\Plugin\\widgets\\WidgetsElement::checkHomeOnly",
            "note": "2nd and 3rd arguments removed: check calls and overrides"
        }
    ]
}
